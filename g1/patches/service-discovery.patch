+    std::this_thread::sleep_for(std::min(remaining(), discovery_grace));
+    if (remaining() == Clock::duration::zero())
+    {
+        RCLCPP_ERROR(node->get_logger(), "service '%s' discovery budget expired", service.c_str());
+        return nullptr;
+    }
     auto future = client->async_send_request(request);
     if (rclcpp::spin_until_future_complete(node, future, remaining()) !=
         rclcpp::FutureReturnCode::SUCCESS)
     {
+        client->remove_pending_request(future);
         RCLCPP_ERROR(node->get_logger(), "call to '%s' did not return", service.c_str());
         return nullptr;
     }
