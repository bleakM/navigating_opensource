<?xml version="1.0"?>
<!--
  Explores the building and builds the world model: rooms, objects and what the head camera has
  seen of them. Pass one walks to frontiers until the LiDAR map is closed; on a complete map it
  ends at once. Pass two makes the camera see what the map holds, one viewpoint at a time: walk
  there, face each heading, dwell while the detector answers, report. The world model plans
  every viewpoint from what the camera actually measured, and the tree only moves the robot.

  Needs Nav2, the world model and a detector publishing masks; the detector's phrases are set at
  launch. Viewpoints Nav2 cannot reach are reported and avoided, never retried here.
-->
<root BTCPP_format="4" main_tree_to_execute="Explore">
  <BehaviorTree ID="Explore">
    <Sequence name="explore">
      <!-- RGB-D must observe the floor behind the fixed start as well. Without
           this first look, a long corridor can appear disconnected in the
           observed grid and the frontier pass may visit only one side.
           TurnTo uses Nav2 and the real gait; no pose is assigned here. -->
      <Sleep name="wait_for_executor_tf_subscription" msec="2000"/>
      <ForceSuccess><TurnTo name="initial_look_left" yaw="1.57079632679"/></ForceSuccess>
      <ForceSuccess><TurnTo name="initial_look_back" yaw="3.14159265359"/></ForceSuccess>
      <ForceSuccess><TurnTo name="initial_look_right" yaw="-1.57079632679"/></ForceSuccess>
      <ForceSuccess><TurnTo name="initial_look_forward" yaw="0.0"/></ForceSuccess>
      <SubTree ID="VisitViewpoints" name="close_the_map" mode="frontier"/>
      <SubTree ID="VisitViewpoints" name="see_every_room" mode="coverage"/>
      <!-- What the world model can tell is not an object goes before anyone checks the map by
           hand; the save must not wait on it. -->
      <ForceSuccess>
        <CleanUpWorld name="clean_up_the_world"/>
      </ForceSuccess>
      <SaveWorld name="save_the_world"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="VisitViewpoints">
    <Sequence name="visit_until_done">
      <!-- NextViewpoint fails when there is nothing left: that ends the loop, and `outcome`
           tells a finished pass from an error. -->
      <ForceSuccess name="loop_ends_when_done">
        <KeepRunningUntilFailure name="viewpoint_loop">
          <Sequence name="one_viewpoint">
            <NextViewpoint name="next_viewpoint" mode="{mode}" goal="{goal}"
                           headings="{headings}" viewpoint_id="{viewpoint}"
                           outcome="{outcome}"/>
            <Fallback name="step_off_or_visit">
              <!-- The last viewpoints all went unreached from here: step further clear, then ask
                   again. The world model resumes where the robot stands if it cannot move. -->
              <Sequence name="step_off_when_stuck">
                <ScriptCondition name="stuck" code="outcome == 'stuck'"/>
                <ForceSuccess name="even_if_boxed_in">
                  <StepClear name="step_clear_when_stuck" clearance="0.7"/>
                </ForceSuccess>
              </Sequence>
              <Fallback name="visit_or_report_unreached">
                <Sequence name="visit">
                  <!-- Nav2 will not start a motion with furniture inside its 0.45 m circle, and the
                       gait's drift leaves the robot there; this is a no-op when it is clear. -->
                  <ForceSuccess name="unless_boxed_in">
                    <StepClear name="step_clear_to_walk"/>
                  </ForceSuccess>
                  <NavigateToPose name="walk_there" goal="{goal}"/>
                  <ForceSuccess name="unless_boxed_in_there">
                    <StepClear name="step_clear_to_turn"/>
                  </ForceSuccess>
                  <LoopDouble name="each_heading" queue="{headings}" value="{heading}">
                    <Sequence name="face_and_dwell">
                      <!-- A spin that falls short still leaves the camera looking somewhere
                           useful; coverage is measured, not assumed. -->
                      <ForceSuccess name="turn_even_if_short">
                        <TurnTo name="face_heading" yaw="{heading}"/>
                      </ForceSuccess>
                      <!-- Geometric depth is processed during movement. Allow
                           fresh frames after the turn without waiting for the
                           disabled semantic detector. -->
                      <Sleep name="dwell_for_fresh_depth" msec="400"/>
                    </Sequence>
                  </LoopDouble>
                  <ReportViewpoint name="report_reached" viewpoint_id="{viewpoint}" reached="true"/>
                </Sequence>
                <ReportViewpoint name="report_unreached" viewpoint_id="{viewpoint}" reached="false"/>
              </Fallback>
            </Fallback>
          </Sequence>
        </KeepRunningUntilFailure>
      </ForceSuccess>
      <ScriptCondition name="stopped_because_done" code="outcome == 'done'"/>
    </Sequence>
  </BehaviorTree>
</root>
